# 로컬 전용 오버라이드는 .env.local (gitignore)에 두세요.
# EXPO_PUBLIC_API_URL 이 있으면 APP_ENV보다 우선합니다.

# APP_ENV=development   → cucumber-develop.up.railway.app
# APP_ENV=production    → cucumber-production.up.railway.app

# npm run android:prod  → APP_ENV=production 로 로컬 릴리스 빌드
# eas build -p android --profile production
