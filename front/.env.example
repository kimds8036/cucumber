# 로컬 전용 — 이 파일을 복사해 `.env.development` 또는 `.env.local` 로 저장

# APP_ENV=development | production → config/apiEnv.js 의 Railway URL 사용
APP_ENV=development

# 명시 URL이 있으면 APP_ENV보다 우선 (스토어 심사용 공개 URL은 코드에 있어도 무방)
# EXPO_PUBLIC_API_URL=https://cucumber-develop.up.railway.app

# 회원가입 mock/SKIP 플로우 — __DEV__만 동작. false면 SKIP OFF
EXPO_PUBLIC_SIGNUP_TEST_MODE=false

# 성인 생년월일 완화(구 임시) — 사용하지 않음. 항상 false/미설정
EXPO_PUBLIC_SIGNUP_ADULT_TEST_MODE=false

# KG 이니시스 본인인증 실연동 (서버 INICIS_ENABLED=true 와 함께)
EXPO_PUBLIC_INICIS_ENABLED=true

# 등교 인정 반경: 300m 고정 (front/utils/commuteGeo.js COMMUTE_GEOFENCE_METERS)
