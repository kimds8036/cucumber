# ============================================================
# 로컬 전용 설정 예시
# ------------------------------------------------------------
# 이 파일 자체는 앱에 적용되지 않습니다.
# 복사해서 쓰세요:
#   copy .env.example .env.development
# (또는 .env.local)
#
# 그다음 앱을 다시 빌드/실행해야 반영됩니다.
#   예) npm run android:device:dev
# ============================================================

# APP_ENV=development | production
# → Railway develop / production 서버 URL (config/apiEnv.js)
APP_ENV=development

# 명시 URL이 있으면 APP_ENV보다 우선 (보통은 비워 둠)
# EXPO_PUBLIC_API_URL=https://cucumber-develop.up.railway.app

# ------------------------------------------------------------
# EXPO_PUBLIC_SIGNUP_TEST_MODE
# 회원가입 단계를 mock으로 건너뛰기 (생년월일·이니시스·학생증 스킵)
# - 폰에 직접 설치하는 debug 빌드(__DEV__)에서만 동작
# - 스토어용 release/AAB 에서는 어떤 값이든 절대 스킵되지 않음
#
# false = 정상 가입 플로우 (생년월일 입력, KG 이니시스 열림) ← 팀 테스트 권장
# true  = UI만 빠르게 넘어가기 (가입이 “스킵”된 것처럼 보임)
# ------------------------------------------------------------
EXPO_PUBLIC_SIGNUP_TEST_MODE=false

# ------------------------------------------------------------
# EXPO_PUBLIC_SIGNUP_ADULT_TEST_MODE
# 중·고등학생만 가입되는 연령 차단을 잠시 풂 (성인 생년월일로도 진행)
# - debug 빌드(__DEV__) + true 일 때만
# - 너무 어린 연령(만 14세 미만 등) 차단은 그대로 둠
# - 스토어 빌드에서는 항상 학생 연령만 허용
#
# false = 정식 정책 (성인·과연령 가입 불가)
# true  = 개발/내부 테스트용으로 성인 생년월일 허용 ← 당분간 권장
# ------------------------------------------------------------
EXPO_PUBLIC_SIGNUP_ADULT_TEST_MODE=true

# ------------------------------------------------------------
# EXPO_PUBLIC_INICIS_ENABLED
# KG 이니시스 본인인증 앱 쪽 켜기
# - true  = 실제 이니시스 화면 시도 (서버 INICIS_ENABLED=true 도 필요)
# - false/미설정 = 앱에서 mock («테스트 mock») — 스토어 AAB에 절대 넣지 말 것
#
# ⚠ android:aab:prod / eas.json production / .env.production 모두 true 필수
#   (device 스크립트에만 있고 AAB에 빠지면 스토어만 mock — 2026-07-16)
# 자세한 체크: front/docs/빌드_EXPO_PUBLIC_체크리스트.md
# ------------------------------------------------------------
EXPO_PUBLIC_INICIS_ENABLED=true

# 스토어용 로컬 .env.production 예시 (복사해 사용, gitignore):
#   APP_ENV=production
#   EXPO_PUBLIC_SIGNUP_TEST_MODE=false
#   EXPO_PUBLIC_SIGNUP_ADULT_TEST_MODE=false
#   EXPO_PUBLIC_INICIS_ENABLED=true

# 등교 인정 반경: 300m 고정 (front/utils/commuteGeo.js COMMUTE_GEOFENCE_METERS)
