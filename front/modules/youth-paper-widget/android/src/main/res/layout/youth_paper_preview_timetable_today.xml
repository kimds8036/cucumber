<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#FFFFFF"
  android:orientation="vertical"
  android:padding="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_period_chip"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingLeft="9dp"
      android:paddingTop="4dp"
      android:paddingRight="10dp"
      android:paddingBottom="5dp">

      <ImageView
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="5dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_dot_circle"
        android:tint="#FFCCE2FC" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="6교시 (14:00-14:50)"
        android:textColor="#FF272A26"
        android:textSize="11sp" />
    </LinearLayout>

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:gravity="end"
      android:maxLines="1"
      android:text="8월 18일 화"
      android:textColor="#8C272A26"
      android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="4dp"
    android:paddingStart="14dp"
    android:paddingEnd="4dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:text="음악감상과비평"
    android:textColor="#FF272A26"
    android:textSize="28sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="6dp"
    android:background="#14272A26"
    android:text="" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1교시" android:textColor="#FF888780" android:textSize="9sp" />
      <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:contentDescription="@null" android:src="@drawable/widget_dot_circle" android:tint="#FFFFD6D6" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="국어" android:textColor="#FF272A26" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2교시" android:textColor="#FF888780" android:textSize="9sp" />
      <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:contentDescription="@null" android:src="@drawable/widget_dot_circle" android:tint="#FFCBEBC5" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="영어" android:textColor="#FF272A26" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3교시" android:textColor="#FF888780" android:textSize="9sp" />
      <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:contentDescription="@null" android:src="@drawable/widget_dot_circle" android:tint="#FFFFF8DB" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="한국사" android:textColor="#FF272A26" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4교시" android:textColor="#FF888780" android:textSize="9sp" />
      <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:contentDescription="@null" android:src="@drawable/widget_dot_circle" android:tint="#FFFFEAC1" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="과학" android:textColor="#FF272A26" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5교시" android:textColor="#FF888780" android:textSize="9sp" />
      <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:contentDescription="@null" android:src="@drawable/widget_dot_circle" android:tint="#FFEAD4FC" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="체육" android:textColor="#FF272A26" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/widget_chip_p8" android:gravity="center" android:orientation="vertical" android:padding="3dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6교시" android:textColor="#FF6F9163" android:textSize="9sp" />
      <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:contentDescription="@null" android:src="@drawable/widget_dot_circle" android:tint="#FFCCE2FC" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="음악감.." android:textColor="#FF272A26" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7교시" android:textColor="#FF888780" android:textSize="9sp" />
      <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:contentDescription="@null" android:src="@drawable/widget_dot_circle" android:tint="#FFE8E8E8" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="생활.." android:textColor="#FF272A26" android:textSize="10sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
