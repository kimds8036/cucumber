{
  "name": "cucumber",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:prod": "cross-env APP_ENV=production expo start",
    "android": "expo run:android",
    "clean:android": "node scripts/clean-android-build.mjs",
    "env:print:dev": "cross-env APP_ENV=development node scripts/print-api-env.mjs",
    "env:print:prod": "cross-env APP_ENV=production node scripts/print-api-env.mjs",
    "prebuild:android:dev": "cross-env APP_ENV=development expo prebuild --platform android --clean",
    "prebuild:android:prod": "cross-env APP_ENV=production expo prebuild --platform android --clean",
    "android:device:dev": "npm run clean:android && npm run prebuild:android:dev && cross-env APP_ENV=development expo run:android",
    "android:device:prod": "npm run clean:android && npm run prebuild:android:prod && cross-env APP_ENV=production expo run:android",
    "android:aab:prod": "npm run clean:android && npm run prebuild:android:prod && npm run env:print:prod && cross-env APP_ENV=production NODE_ENV=production node scripts/gradle-bundle-release.mjs",
    "android:prod": "npm run android:device:prod",
    "android:bundle-dev": "cross-env APP_ENV=development expo run:android --variant release",
    "android:bundle-prod": "cross-env APP_ENV=production expo run:android --variant release",
    "android:aab-prod": "npm run android:aab:prod",
    "credentials:android": "eas credentials -p android",
    "ios": "expo run:ios",
    "ios:prod": "cross-env APP_ENV=production expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-native-fontawesome": "^0.3.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-native-menu/menu": "^2.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.9.1",
    "@react-navigation/native": "^7.1.27",
    "@react-navigation/native-stack": "^7.9.1",
    "@shopify/flash-list": "2.0.2",
    "axios": "^1.13.6",
    "expo": "~56.0.8",
    "expo-build-properties": "~56.0.16",
    "expo-camera": "~56.0.7",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "^56.0.16",
    "expo-dev-client": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-image-picker": "~56.0.15",
    "expo-location": "~56.0.15",
    "expo-media-library": "~56.0.6",
    "expo-notifications": "~56.0.15",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "~56.0.4",
    "lottie-react-native": "~7.3.4",
    "neis": "^0.3.1",
    "nodemon": "^3.1.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-context-menu-view": "^1.21.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.2",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "^7.0.3",
    "license-checker": "^25.0.1",
    "react-native-asset": "^2.2.8"
  }
}
