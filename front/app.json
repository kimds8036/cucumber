{
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  },
  "expo": {
    "name": "Youth Paper",
    "slug": "youth-paper",
    "version": "2.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon-android.png",
      "resizeMode": "contain",
      "backgroundColor": "#E5F4E0"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "56",
      "icon": "./assets/icon-ios.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "학생인증을 위해 카메라 접근 권한이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "게시판 근처 글·거리 표시를 위해 사용 중에만 위치 정보를 사용합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ucost.YouthPaper",
      "splash": {
        "image": "./assets/splash-icon-android.png",
        "resizeMode": "contain",
        "backgroundColor": "#E5F4E0"
      }
    },
    "android": {
      "usesCleartextTraffic": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/splash-icon-android.png",
        "resizeMode": "contain",
        "backgroundColor": "#E5F4E0"
      },
      "edgeToEdgeEnabled": true,
      "navigationBar": {
        "backgroundColor": "#ffffff",
        "barStyle": "dark-content"
      },
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.ucost.YouthPaper",
      "versionCode": 45,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "게시판 근처 글·거리 표시를 위해 사용 중에만 위치 정보를 사용합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "캡처한 이미지를 갤러리에 저장하기 위해 권한이 필요합니다.",
          "granularPermissions": []
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "enableSceneSupport": true,
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "FirebaseCoreInternal",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "얼굴 인식을 사용하여 앱을 잠금 해제합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "39e0f4f8-dd46-4921-a4bf-68856fdfc85c"
      }
    },
    "owner": "ucost"
  }
}
