{
  "name": "cucumber-backend",
  "version": "1.0.0",
  "description": "Cucumber backend API server",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/db/migrate.js && node src/index.js",
    "start:worker": "node src/workers/notificationWorker.entry.js",
    "start:scheduler": "node src/workers/scheduler.entry.js",
    "dev": "nodemon --watch src src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:develop": "node src/db/migrate.js --target=develop",
    "migrate:production": "node src/db/migrate.js --target=production",
    "migrate:all": "node src/db/migrate.js --all",
    "seed:schools": "node src/db/seed-schools-from-csv.js",
    "seed:reset-admins": "node src/db/seed-reset-and-admins.js",
    "seed:admin-users": "node src/db/seed-admin-from-env.js",
    "seed:admins": "node src/db/seed-admin-from-env.js",
    "db:reset-keep-schools": "node src/db/reset-keep-schools.js",
    "seed:dev-test-user": "node src/db/seed-dev-test-user.js",
    "seed:load-test-students": "node src/db/seed-load-test-students.js",
    "seed:load-test-chat": "node load-test/seed-chat-rooms.js",
    "load-test:chat": "node load-test/chat-load-test.js",
    "migrate:pii-encrypt": "node src/db/migrate-pii-encrypt.js",
    "db:generate-init": "node src/db/generate-001-init-from-db.js",
    "db:build-init": "node src/db/build-001-init-from-archive.js",
    "db:squash-baseline": "node src/db/squash-baseline.js",
    "badges:backfill-first-post": "node scripts/backfill-first-post-badges.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@kr-yeon/kisa-seed": "^1.0.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.6.5",
    "node-cron": "^4.2.1",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3"
  }
}
