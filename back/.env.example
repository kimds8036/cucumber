# ========================
# 서버
# ========================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
ENABLE_TEST_API=false

# 로컬 기본 DB 대상 (develop | production)
# develop 브랜치 작업 시 develop, production 브랜치 작업 시 production
RAILWAY_TARGET=develop

# ========================
# Develop Railway MySQL
# ========================
# Railway develop API 서비스 Variables (런타임 — 접두사 없이 써도 됨)
# DB_PRIVATE_HOST=mysql.railway.internal
# DB_PRIVATE_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=railway

# 로컬 .env — develop + production 동시 보관 시 DEVELOP_ 접두사
DEVELOP_DB_PRIVATE_HOST=mysql.railway.internal
DEVELOP_DB_PRIVATE_PORT=3306
DEVELOP_DB_TUNNEL_HOST=127.0.0.1
DEVELOP_DB_TUNNEL_PORT=3306
DEVELOP_DB_USER=
DEVELOP_DB_PASSWORD=
DEVELOP_DB_NAME=railway

# ========================
# Production Railway MySQL
# ========================
PRODUCTION_DB_PRIVATE_HOST=mysql.railway.internal
PRODUCTION_DB_PRIVATE_PORT=3306
PRODUCTION_DB_TUNNEL_HOST=127.0.0.1
PRODUCTION_DB_TUNNEL_PORT=3307
PRODUCTION_DB_USER=
PRODUCTION_DB_PASSWORD=
PRODUCTION_DB_NAME=railway

# ========================
# JWT / 관리자
# ========================
JWT_SECRET=
JWT_EXPIRES_IN=1h
OTP_ENCRYPTION_KEY=
ADMIN_OTP_ISSUER=Youth Paper Admin
ADMIN_JWT_EXPIRES_IN=30m
ADMIN_SEED_1_USERNAME=
ADMIN_SEED_1_PASSWORD=
ADMIN_SEED_1_NAME=관리자 1

# ========================
# CORS / 외부 API / Firebase (생략 시 back/.env.example 전체 참고)
# ========================
CORS_ORIGIN=
