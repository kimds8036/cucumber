# ========================
# 서버
# ========================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
ENABLE_TEST_API=false

# 로컬 기본 DB 대상 (develop | production)
# develop 브랜치 작업 시 develop, production 브랜치 작업 시 production
RAILWAY_TARGET=develop

# 개인우편 반송 배치 (일수 / cron)
# PERSONAL_MAIL_RETURN_DAYS=1
# CRON_PERSONAL_MAIL_RETURN=0 4 * * *

# ========================
# Develop Railway MySQL
# ========================
# Railway develop API 서비스 Variables (런타임 — 접두사 없이 써도 됨)
# DB_PRIVATE_HOST=mysql.railway.internal
# DB_PRIVATE_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=railway

# 로컬 .env — develop + production 동시 보관 시 DEVELOP_ 접두사
DEVELOP_DB_PRIVATE_HOST=mysql.railway.internal
DEVELOP_DB_PRIVATE_PORT=3306
DEVELOP_DB_TUNNEL_HOST=127.0.0.1
DEVELOP_DB_TUNNEL_PORT=3306
DEVELOP_DB_USER=
DEVELOP_DB_PASSWORD=
DEVELOP_DB_NAME=railway

# ========================
# Production Railway MySQL
# ========================
PRODUCTION_DB_PRIVATE_HOST=mysql.railway.internal
PRODUCTION_DB_PRIVATE_PORT=3306
PRODUCTION_DB_TUNNEL_HOST=127.0.0.1
PRODUCTION_DB_TUNNEL_PORT=3307
PRODUCTION_DB_USER=
PRODUCTION_DB_PASSWORD=
PRODUCTION_DB_NAME=railway

# ========================
# DB 풀 / bcrypt (부하·로그인 성능)
# ========================
# MySQL connectionLimit (기본 30, 최대 100)
DB_CONNECTION_LIMIT=30
# bcrypt salt rounds (8~10, 기본 10 — 로그인 CPU 부하와 보안 균형)
BCRYPT_SALT_ROUNDS=8

# ========================
# JWT / 관리자
# ========================
JWT_SECRET=
JWT_EXPIRES_IN=15m
OTP_ENCRYPTION_KEY=
# 사용자 PII(이름/전화/생년) AES-256-GCM + HMAC lookup (미설정 시 OTP_ENCRYPTION_KEY 폴백)
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=
ADMIN_OTP_ISSUER=Youth Paper Admin
ADMIN_JWT_EXPIRES_IN=30m
# 관리자 웹 UI 경로 (유추 어려운 값, 환경별로 다르게 설정 권장)
# 예: /x-cp-7k3m9xq2w4n — /admin 은 사용 불가
ADMIN_BASE_PATH=/x-cp-7k3m9xq2w4n
ADMIN_SEED_1_USERNAME=
ADMIN_SEED_1_PASSWORD=
ADMIN_SEED_1_NAME=관리자 1

# ========================
# CORS / 외부 API / Firebase (생략 시 back/.env.example 전체 참고)
# ========================
CORS_ORIGIN=

# ========================
# 등교 체크 (운영 기본: 07:00~10:00, 지오펜스 300m 고정)
# ========================
# ATTENDANCE_WINDOW_START=07:00
# ATTENDANCE_WINDOW_END=10:00
# 코드 기본 반경: 300m (attendance.service.js ATTENDANCE_GEOFENCE_METERS)

# ========================
# 제품 분석 (익명 집계, Phase 0)
# ========================
# ANALYTICS_ENABLED=true
# ANALYTICS_PEPPER=   # 미설정 시 JWT_SECRET 사용
# ANALYTICS_REDIS_TTL_SECONDS=172800
# ANALYTICS_MAU_ROLLING_DAYS=30
# RATE_LIMIT_ANALYTICS_PER_MIN=120
# CRON_ANALYTICS_RECONCILE=0 4 * * *

# ========================
# KG 이니시스 통합인증 (간편인증)
# ========================
# 기본 false — 실호출 전 테스트 MID/도메인 등록 확인 후 true
INICIS_ENABLED=false
# TEST MID / API KEY / SEED IV (값 커밋 금지)
INICIS_MID=
INICIS_API_KEY=
INICIS_SEED_IV=
# (선택) 구형/테스트용 고정 SEED Key — 통합인증은 STEP2 token 이 KEY (매뉴얼)
# INICIS_SEED_KEY=
# 본인확인(03) 전용 — 간편인증(01)에서는 미사용
# INICIS_DI_CODE=
INICIS_REQ_SVC_CD=01
# 이니시스에 등록된(또는 등록 예정) 백엔드 HTTPS 도메인 (끝 / 없이)
# success/fail 기본: ${INICIS_PUBLIC_BASE_URL}/api/auth/inicis/callback/success|fail
INICIS_PUBLIC_BASE_URL=
# INICIS_SUCCESS_URL=
# INICIS_FAIL_URL=
# INICIS_SESSION_TTL_MINUTES=30

# ========================
# 스토어 URL / 광고 설치 랜딩
# ========================
# 강제 업데이트·인스타 /get 랜딩 공용 (미설정 시 코드 기본값)
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.ucost.YouthPaper
# IOS_STORE_URL=https://apps.apple.com/app/id6770454607
# 인스타 「더 알아보기」: https://<Railway공개도메인>/get  (별도 URL 변수 불필요)
# INSTALL_LANDING_TITLE=Youth Paper
# INSTALL_LANDING_DESCRIPTION=학교 인증 학생 커뮤니티
# INSTALL_LANDING_OG_IMAGE=https://...

# ========================
# Discord 관리자 알림 (웹훅)
# ========================
# true 일 때만 전송. URL 실값은 Railway Variables에만 두고 Git에 올리지 말 것
DISCORD_WEBHOOK_ENABLED=false
# DISCORD_WEBHOOK_URL=                 # (선택) 단일 채널 폴백
# DISCORD_WEBHOOK_URL_REVIEW=          # 학생증·증명서 검수
# DISCORD_WEBHOOK_URL_INQUIRY=         # 문의
# DISCORD_WEBHOOK_URL_REPORT=          # 신고·자동숨김·이의
# DISCORD_WEBHOOK_MENTION=             # (선택) 자동숨김 시 <@&역할ID>
# PUBLIC_API_BASE_URL=                 # (선택) Embed 관리자 링크용 https://…

