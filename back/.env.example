# ========================
# 서버
# ========================
NODE_ENV=development
PORT=3000
HOST=localhost

# 운영(production) 환경에서 /api/test/* 라우트를 강제 차단한다.
# 진짜로 켜야 할 때만 'true' 로 둘 것.
ENABLE_TEST_API=false

# ========================
# DB
# (값이 없으면 서버는 일단 부팅되지만 모든 쿼리가 실패한다.
#  운영에서는 모든 값이 채워져 있어야 한다.)
# ========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=cucumber
DB_PASSWORD=
DB_NAME=cucumber

# ========================
# Redis (Bull queue + 배치 캐시)
# ========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================
# JWT — 부팅 시 fail-fast
#   JWT_SECRET 누락 시 서버 시작 거부됨.
#   생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ========================
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ========================
# CORS
#   운영 환경에서는 허용 origin 을 콤마(,) 로 구분해 명시한다.
#   예) https://admin.example.com,https://www.example.com
#   모바일 앱(origin 헤더 없음)은 자동 통과되므로 여기에 적지 않아도 된다.
# ========================
CORS_ORIGIN=

# ========================
# Firebase (FCM Admin SDK)
#   1) 서비스 계정 JSON 파일 경로를 쓰거나 (FIREBASE_SERVICE_ACCOUNT_PATH)
#   2) 아래 3개 env 를 모두 채우거나 — 둘 중 하나만 있으면 된다.
# ========================
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ========================
# Cloudinary (이미지 업로드)
# ========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========================
# Cron / 배치
# ========================
ENABLE_CRON=true
CRON_TIMEZONE=Asia/Seoul
# CRON_STUDY_GRASS=5 * * * *
# CRON_TRENDING_SETTLE=*/10 * * * *
# CRON_SCHOOL_STATS=0 * * * *
# CRON_TIMER_GUARD=*/10 * * * *

# ========================
# 배치 알림 webhook (선택)
# ========================
BATCH_ALERT_WEBHOOK_URL=
