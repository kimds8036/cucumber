# ========================
# 서버
# ========================
NODE_ENV=development
PORT=3000
# 로컬에서 백엔드만 띄울 때는 0.0.0.0 권장
# HOST=0.0.0.0
HOST=localhost

# 운영(production) 환경에서 /api/test/* 라우트를 강제 차단한다.
# 진짜로 켜야 할 때만 'true' 로 둘 것.
# ⚠️ 테스트 끝나면 반드시 false 로 되돌릴 것 (Railway Variables 에서도).
#    켜진 상태로 출시하면 테스트 계정 목록이 외부에 노출된다.
ENABLE_TEST_API=false

# API rate limit (express-rate-limit). 미설정 시 index.js 기본값 사용.
# RATE_LIMIT_AUTH_MAX: /api/auth 의 POST 등(15분 윈도). GET(/me 등)은 기본적으로 제한에서 제외됨.
# RATE_LIMIT_API_PER_MIN: /api 전체(1분 윈도).
# RATE_LIMIT_AUTH_MAX=60
# RATE_LIMIT_API_PER_MIN=300
# RATE_LIMIT_ADMIN_LOGIN_MAX=10

# ========================
# DB — 로컬 Docker / 로컬 MySQL (develop·init 브랜치에서는 기본 비활성, 주석만 유지)
# ========================
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=cucumber
# DB_PASSWORD=cucumber0425
# DB_NAME=cucumber

# ========================
# DB — Railway develop (로컬에서 `npm run dev`로 백엔드만 돌릴 때)
#   - MySQL 플러그인 Variables: RAILWAY_TCP_PROXY_DOMAIN / RAILWAY_TCP_PROXY_PORT
#   - 내부 호스트(mysql.railway.internal)는 로컬 PC에서 접근 불가 → public 프록시만 사용
#   - 아래 값은 예시이며, 실제 비밀번호·포트는 본인 Railway 화면 값으로 교체
# ========================
# DB_HOST=turntable.proxy.rlwy.net
# DB_PORT=17117
# DB_USER=root
# DB_PASSWORD=<MYSQL_ROOT_PASSWORD>
# DB_NAME=railway

# ========================
# Redis — 로컬 (develop·init 브랜치 기본 비활성)
# ========================
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ========================
# Redis — Railway develop (Bull 알림 큐 + 배치 캐시)
#   - develop 프로젝트의 Redis 서비스 Variables에서
#     REDIS_PUBLIC_URL 또는 REDISHOST + RAILWAY_TCP_PROXY_* 를 확인해 public 주소로 채울 것
# ========================
# REDIS_HOST=turntable.proxy.rlwy.net
# REDIS_PORT=<Redis RAILWAY_TCP_PROXY_PORT>
# REDIS_PASSWORD=<Redis REDISPASSWORD>

# ========================
# JWT — 부팅 시 fail-fast
#   JWT_SECRET 누락 시 서버 시작 거부됨.
#   생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ========================
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ========================
# CORS
#   운영 환경에서는 허용 origin 을 콤마(,) 로 구분해 명시한다.
#   예) https://admin.example.com,https://www.example.com
#   모바일 앱(origin 헤더 없음)은 자동 통과되므로 여기에 적지 않아도 된다.
# ========================
CORS_ORIGIN=

# ========================
# Firebase (FCM Admin SDK)
#   1) 서비스 계정 JSON 파일 경로를 쓰거나 (FIREBASE_SERVICE_ACCOUNT_PATH)
#   2) 아래 3개 env 를 모두 채우거나 — 둘 중 하나만 있으면 된다.
# ========================
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ========================
# Cloudinary (이미지 업로드)
# ========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========================
# Cron / 배치
# ========================
ENABLE_CRON=true
CRON_TIMEZONE=Asia/Seoul
# CRON_STUDY_GRASS=5 * * * *
# CRON_TRENDING_SETTLE=*/10 * * * *
# CRON_SCHOOL_STATS=0 * * * *
# CRON_TIMER_GUARD=*/10 * * * *

# ========================
# 배치 알림 webhook (선택)
# ========================
BATCH_ALERT_WEBHOOK_URL=
