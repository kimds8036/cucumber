# ==========================================
# [의존성 및 빌드 결과물]
# ==========================================
**/node_modules/
**/dist/
**/build/
**/out/
**/web-build/

# ==========================================
# [Frontend - Expo & Metro]
# ==========================================
**/.expo/
**/expo-env.d.ts
**/.metro-health-check*

# ==========================================
# [Frontend - Native / Mobile]
# ==========================================
**/ios/
**/android/
# Expo 위젯 모듈 네이티브 소스는 추적 (앱 prebuild android/ios 와 구분)
!front/modules/youth-paper-widget/android/
!front/modules/youth-paper-widget/android/**
front/modules/youth-paper-widget/android/build/
front/modules/youth-paper-widget/android/build/**
front/modules/youth-paper-widget/android/.gradle/
front/modules/youth-paper-widget/android/.gradle/**
!front/modules/youth-paper-widget/ios/
!front/modules/youth-paper-widget/ios/**
**/.kotlin/
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/*.orig.*
**/*.plist
# Firebase client config (앱에 포함되어야 함; Admin SDK JSON은 위에서 계속 차단)
!front/GoogleService-Info.plist

# ==========================================
# [Backend]
# ==========================================
**/*.log
npm-debug.*
yarn-debug.*
yarn-error.*
# Firebase Admin SDK JSON (비밀키 — 커밋 금지)
back/**/*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
**/*-adminsdk-*.json

# ==========================================
# [환경변수 & 보안 — 공개 GitHub 필수]
# ==========================================
.env
.env.*
!.env.example
!**/.env.example
*.pem
credentials.json
**/credentials.json
!**/credentials.json.example
front/.env.development
front/.env.production
front/.env.local
back/.env
back/.env.local
back/.env.*.local

# 로컬 DB 덤프·백업 (실수 커밋 방지)
**/*.sql.gz
**/db-dumps/
**/database_backup/

# ==========================================
# [TypeScript]
# ==========================================
*.tsbuildinfo

# ==========================================
# [OS]
# ==========================================
.DS_Store

# ==========================================
# [프로젝트 전용]
# ==========================================
# 로컬 전용 문서 (저장소 루트 / 백엔드 docs — GitHub 미업로드)
/docs/
back/docs/

# 앱에 번들되는 약관 원문
!front/docs/
!front/docs/legal/
!front/docs/legal/**

# 마이그레이션 SQL은 스키마 정의이므로 커밋 유지 (비밀값 넣지 말 것)
